# This file documents all available environment variables.
# You can copy this file to `.env` in the root of the repository to override defaults locally
# or use these names when setting up your background service/Docker container.

# --- Core Service configuration ---
# Path to the TOML configuration file
EDGE_MONITOR_CONFIG_PATH=config/edge_monitor_config.toml

# TLS Certificates for the Webserver
TLS_CERT_PATH=cert/cert.pem
TLS_KEY_PATH=cert/key.pem

# --- Database ---
# URL for the SQLite database. Usually a local file.
DATABASE_URL=sqlite://soundscape.db

# --- Audio Capture ---
# Optional input device filter (substring match against raw/friendly device names).
# Leave unset to use the system default input device.
AUDIO_DEVICE=RØDE

# --- Machine Learning Models ---
# Optional explicit model overrides. If these are not set, edge-monitor
# auto-discovers the newest complete model triplet in data/models
# (embedder, classifier, label_mapping) by highest vN suffix.
# Set to false to disable auto-discovery and rely on explicit/fallback paths.
AUTO_DISCOVER_MODEL_PATHS=true
# Optional: force model loading from a single "current" folder.
# When set, edge-monitor expects exactly one file of each type in this folder:
# *_embedder.onnx, *_classifier.onnx, *_label_mapping.json
# Example:
# CURRENT_MODEL_PATH="/home/edge-monitor/equine-ai-monitor/apps/edge-monitor/data/models/current"
#
# CURRENT_MODEL_PATH=
#
# EMBEDDER_PATH=data/models/champion_v26_embedder.onnx
# CLASSIFIER_PATH=data/models/champion_v26_classifier.onnx
# LABEL_MAPPING_PATH=data/models/champion_v26_label_mapping.json

# --- FCM Push Notifications ---
# FCM Server Key for sending push notifications to client devices.
# You can obtain this from the Firebase Console under Project Settings > Cloud Messaging.
SERVICE_ACCOUNT_KEY="PATH-TO-SERVICE-ACCOUNT-JSON"  # path to the Google service-account JSON file see here: https://gitlab.ai.ky.local/digicenter/horse/connecttofcm
FCM_TOPIC="horse-warnings"  # FCM topic to publish to
