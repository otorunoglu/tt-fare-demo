<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tekoälyä Talleille - AI for Horse Welfare</title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/bootstrap.min.css') }}">
     <!-- Font Awesome -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/all.min.css') }}">
    <style>
        /* =========================================================
           COLOR SYSTEM
        ========================================================= */
        :root {
            --green-primary: #237A45;
            --green-dark: #155C35;
            --green-deep: #0F4930;
            --green-soft: #E2F0E7;
            --green-light: #F0F7F2;
            --navy-green: #163D3A;
            --navy: #183044;
            --text-main: #243C3A;
            --text-light: #687C77;
            --background: #EEF4F0;
            --white: #FFFFFF;
            --border: #D9E6DE;
            --shadow: 0 8px 28px rgba(21, 92, 53, 0.09);
            --shadow-hover: 0 14px 35px rgba(21, 92, 53, 0.14);
        }
        /* =========================================================
           GLOBAL
        ========================================================= */
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at 10% 10%, rgba(35, 122, 69, 0.07), transparent 30%),
                radial-gradient(circle at 90% 20%, rgba(35, 122, 69, 0.05), transparent 30%),
                var(--background);
            color: var(--text-main);
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .container { max-width: 1500px; }
        /* =========================================================
           HEADER
        ========================================================= */
        header.main-header {
            position: relative;
            overflow: hidden;
            min-height: 170px;
            padding: 27px 35px;
            margin-bottom: 24px;
            border-radius: 22px;
            border: 1px solid rgba(21, 92, 53, 0.12);
            background: linear-gradient(
                90deg,
                rgba(241, 248, 243, 0.98) 0%,
                rgba(241, 248, 243, 0.94) 47%,
                rgba(225, 239, 229, 0.78) 75%,
                rgba(208, 228, 214, 0.70) 100%
            );
            box-shadow: var(--shadow);
        }
        header.main-header::after {
            content: "";
            position: absolute;
            z-index: 0;
            right: -15px;
            top: -45px;
            width: 520px;
            height: 260px;
            background-image:
                linear-gradient(90deg, rgba(241, 248, 243, 1) 0%, rgba(241, 248, 243, 0.55) 28%, rgba(241, 248, 243, 0) 70%),
                url("{{ url_for('static', filename='images/header.jpg') }}");
            background-size: cover;
            background-position: center;
            opacity: 0.88;
            pointer-events: none;
        }
        .header-content {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            flex-wrap: wrap;
        }
        .header-title-area {
            display: flex;
            align-items: center;
            gap: 18px;
        }
        .header-horse-img {
            width: 280px;
            height: auto;
            object-fit: contain;
            border-radius: 12px;
            background: transparent;
            flex-shrink: 0;
        }
        .brand-title {
            margin: 0;
            color: var(--navy-green);
            font-size: clamp(1.75rem, 3vw, 2.4rem);
            font-weight: 800;
            letter-spacing: -1px;
        }
        .brand-title span { color: var(--green-dark); }
        .brand-subtitle {
            margin: 4px 0 0;
            color: #315650;
            font-size: 1rem;
            font-weight: 600;
        }
        .brand-description {
            margin: 4px 0 0;
            color: var(--text-light);
            font-size: 0.84rem;
        }
        /* =========================================================
           LIVE STATUS
        ========================================================= */
        .system-status {
            position: relative;
            z-index: 3;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 17px;
            background: rgba(255, 255, 255, 0.94);
            border: 1px solid rgba(35, 122, 69, 0.18);
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(21, 92, 53, 0.08);
        }
        .live-dot {
            width: 11px;
            height: 11px;
            flex-shrink: 0;
            border-radius: 50%;
            background: #278A4F;
            box-shadow: 0 0 0 5px rgba(39, 138, 79, 0.13);
            animation: livePulse 2s infinite;
        }
        @keyframes livePulse {
            0% { box-shadow: 0 0 0 0 rgba(39, 138, 79, 0.35); }
            70% { box-shadow: 0 0 0 8px rgba(39, 138, 79, 0); }
            100% { box-shadow: 0 0 0 0 rgba(39, 138, 79, 0); }
        }
        .system-status strong {
            display: block;
            color: var(--green-dark);
            font-size: 0.86rem;
        }
        .system-status small {
            color: var(--text-light);
            font-size: 0.7rem;
        }
        /* =========================================================
           HOW IT WORKS
        ========================================================= */
        .step-card {
            position: relative;
            margin-bottom: 20px;
            padding: 2px 24px;
            background: rgba(255, 255, 255, 0.97);
            border: 1px solid var(--border);
            border-radius: 20px;
            box-shadow: 0 7px 24px rgba(21, 92, 53, 0.07);
        }
        .step-card::before {
            content: "HOW IT WORKS";
            display: block;
            margin-bottom: 18px;
            color: var(--green-dark);
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 1.8px;
        }
        .step-item {
            position: relative;
            min-height: 78px;
            padding: 8px 22px;
            text-align: center;
            transition: transform 0.25s ease;
        }
        .step-item:hover { transform: translateY(-2px); }
        .step-icon {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            margin-right: 8px;
            border-radius: 13px;
            background: linear-gradient(145deg, #E5F2E9, #D7EBDD);
            border: 1px solid #C9DFD0;
            color: var(--green-dark);
            font-size: 0.9rem;
            box-shadow: 0 4px 10px rgba(21, 92, 53, 0.07);
        }
        .step-number {
            display: inline-block;
            color: #789087;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.8px;
            vertical-align: middle;
        }
        .step-item strong {
            display: block;
            margin-top: 10px;
            color: var(--navy);
            font-size: 0.88rem;
            font-weight: 800;
        }
        .step-item small {
            display: block;
            margin-top: 4px;
            color: var(--text-light);
            font-size: 0.70rem;
            line-height: 1.45;
        }
        .step-item:not(:last-child)::after {
            content: "";
            position: absolute;
            top: 29px;
            right: -1px;
            width: 42px;
            height: 1px;
            background: linear-gradient(90deg, #C7DCD0, #AFCDBB);
        }
        .step-item:not(:last-child)::before {
            content: "";
            position: absolute;
            z-index: 2;
            top: 25px;
            right: -3px;
            width: 7px;
            height: 7px;
            border-top: 1px solid #8CAF99;
            border-right: 1px solid #8CAF99;
            transform: rotate(45deg);
        }
        /* =========================================================
           CARDS & VISUALIZERS
        ========================================================= */
        .card {
            margin-bottom: 24px;
            background: rgba(255, 255, 255, 0.97);
            border: 1px solid rgba(217, 230, 222, 0.9);
            border-radius: 20px;
            box-shadow: var(--shadow);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        .card:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); }
        .section-title {
            color: var(--navy);
            font-size: 1.08rem;
            font-weight: 800;
            margin-bottom: 4px;
        }
        .section-description {
            color: var(--text-light);
            font-size: 0.81rem;
            line-height: 1.55;
            margin-bottom: 18px;
        }
        .section-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            margin-right: 8px;
            border-radius: 11px;
            background: var(--green-soft);
            color: var(--green-dark);
        }
        .signal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 5px;
        }
        .signal-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 11px;
            border-radius: 20px;
            background: #F2F6F3;
            border: 1px solid var(--border);
            color: var(--text-light);
            font-family: monospace;
            font-size: 0.68rem;
        }
        .mini-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #718B7D;
        }
        .visualizer-wrapper { position: relative; width: 100%; }
        .visualizer-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            font-size: 1.05rem;
            color: var(--navy);
            font-weight: 800;
        }
        .visualizer-live {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #7B8C84;
            font-size: 0.68rem;
        }
        .visualizer-live.active { color: var(--green-dark); }
        .visualizer-live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #9AA9A1;
        }
        .visualizer-live.active .visualizer-live-dot {
            background: #278A4F;
            box-shadow: 0 0 0 4px rgba(39, 138, 79, 0.12);
            animation: visualizerPulse 1s infinite;
        }
        @keyframes visualizerPulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.25); }
            100% { transform: scale(1); }
        }
        #waveform-canvas {
            display: block;
            width: 100%;
            height: 180px;
            background: #F6FBF7;
            border: 1px solid #D6E5DB;
            border-radius: 16px;
            box-shadow: inset 0 0 30px rgba(35, 122, 69, 0.03);
        }
        #spectrogram-canvas {
            display: block;
            width: 100%;
            height: 220px;
            margin-top: 6px;
            background: #081D14;
            border: 1px solid #BBD5C3;
            border-radius: 16px;
            box-shadow: inset 0 0 30px rgba(21, 92, 53, 0.20);
        }
        .spectrogram-legend {
            display: flex;
            justify-content: space-between;
            margin-top: 6px;
            color: #687C77;
            font-size: 0.75rem;
        }
        /* =========================================================
           CONTROLS & BUTTONS
        ========================================================= */
        .control-card { position: relative; overflow: hidden; }
        .control-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: linear-gradient(180deg, var(--green-dark), var(--green-primary));
        }
        .control-info {
            display: flex;
            align-items: center;
            gap: 13px;
            margin-bottom: 15px;
        }
        .control-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            border-radius: 14px;
            background: var(--green-soft);
            color: var(--green-dark);
            font-size: 1.2rem;
        }
        .btn-success {
            min-height: 54px;
            padding: 15px 25px;
            border: none;
            border-radius: 13px;
            background: linear-gradient(135deg, #287F4A, #155C35);
            color: white;
            font-size: 0.96rem;
            font-weight: 700;
            box-shadow: 0 7px 18px rgba(21, 92, 53, 0.25);
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }
        .btn-success:hover {
            background: linear-gradient(135deg, #216E40, #104B2D);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(21, 92, 53, 0.30);
        }
        .btn-success:disabled { opacity: 0.72; cursor: wait; transform: none; }
        /* =========================================================
           AI PREDICTION & ANIMATION
        ========================================================= */
        .ai-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 4px;
        }
        .runtime-badge {
            padding: 6px 11px;
            border-radius: 20px;
            background: var(--green-soft);
            border: 1px solid #C5DDCC;
            color: var(--green-dark);
            font-size: 0.7rem;
            font-weight: 700;
        }
        .ai-display-box {
            position: relative;
            overflow: hidden;
            padding: 30px 25px;
            border: 1px solid #B9D6C1;
            border-radius: 18px;
            background: radial-gradient(circle at 50% 15%, rgba(255,255,255,0.32), transparent 35%), linear-gradient(145deg, #E3F1E7 0%, #D0E8D6 100%);
            color: var(--navy);
            text-align: center;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.75);
        }
        #actionStatus { position: relative; color: var(--green-dark); letter-spacing: 2px; }
        #predictionText {
            position: relative;
            margin: 15px 0;
            color: #125331;
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 800;
            letter-spacing: 1px;
        }
        .confidence-badge {
            position: relative;
            display: inline-block;
            padding: 10px 18px;
            border-radius: 25px;
            background: white;
            color: var(--navy);
            font-size: 0.92rem;
            box-shadow: 0 5px 15px rgba(21, 92, 53, 0.08);
        }
        .confidence-badge i { color: var(--green-dark); }
        .prediction-loading {
            display: none;
            position: relative;
            margin-top: 20px;
            padding: 22px 18px;
            border-radius: 16px;
            background: rgba(255,255,255,0.78);
            border: 1px solid rgba(35,122,69,0.12);
            overflow: hidden;
        }
        .prediction-loading.active { display: block; }
        .analysis-title {
            color: var(--green-dark);
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 14px;
        }
        .analysis-pulse {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 7px;
            height: 42px;
            margin-bottom: 12px;
        }
        .analysis-pulse span {
            width: 6px;
            height: 12px;
            border-radius: 8px;
            background: var(--green-primary);
            animation: aiPulse 1.1s ease-in-out infinite;
        }
        .analysis-pulse span:nth-child(2) { animation-delay: 0.10s; }
        .analysis-pulse span:nth-child(3) { animation-delay: 0.20s; }
        .analysis-pulse span:nth-child(4) { animation-delay: 0.30s; }
        .analysis-pulse span:nth-child(5) { animation-delay: 0.40s; }
        .analysis-pulse span:nth-child(6) { animation-delay: 0.50s; }
        .analysis-pulse span:nth-child(7) { animation-delay: 0.60s; }
        .analysis-pulse span:nth-child(8) { animation-delay: 0.70s; }
        .analysis-pulse span:nth-child(9) { animation-delay: 0.80s; }
        @keyframes aiPulse {
            0%, 100% { height: 12px; opacity: 0.35; }
            50% { height: 36px; opacity: 1; }
        }
        .analysis-scan {
            position: relative;
            height: 5px;
            margin: 0 auto 12px;
            max-width: 360px;
            overflow: hidden;
            border-radius: 10px;
            background: #DDE9E1;
        }
        .analysis-scan::after {
            content: "";
            position: absolute;
            top: 0;
            left: -35%;
            width: 35%;
            height: 100%;
            border-radius: 10px;
            background: linear-gradient(90deg, transparent, var(--green-primary), transparent);
            animation: scanMove 1.6s linear infinite;
        }
        @keyframes scanMove {
            from { left: -35%; }
            to { left: 100%; }
        }
        .analysis-message { color: var(--text-light); font-size: 0.78rem; font-weight: 600; }
        .analysis-count { margin-top: 5px; color: var(--green-dark); font-size: 0.72rem; font-weight: 700; }
        .probability-results { display: none; }
        .probability-results.visible { display: block; animation: resultReveal 0.55s ease-out; }
        @keyframes resultReveal {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .probability-row { margin-bottom: 18px; }
        .probability-label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
            color: var(--navy);
            font-size: 0.83rem;
            font-weight: 600;
        }
        .probability-value { color: var(--green-dark); font-weight: 700; }
        .progress { height: 11px; overflow: hidden; border-radius: 20px; background: #E6EEE9; }
        .progress-bar { border-radius: 20px; background: linear-gradient(90deg, #67A97E, #237A45); transition: width 0.5s ease; }
        /* =========================================================
           FOOTER
        ========================================================= */
        footer {
            position: relative;
            overflow: hidden;
            margin-top: 25px;
            border-radius: 22px;
            border: 1px solid rgba(21, 92, 53, 0.12);
            color: var(--text-main);
            background: linear-gradient(
                90deg,
                rgba(241, 248, 243, 0.98) 0%,
                rgba(241, 248, 243, 0.94) 47%,
                rgba(225, 239, 229, 0.78) 75%,
                rgba(208, 228, 214, 0.70) 100%
            );
            box-shadow: var(--shadow);
        }
        footer::after {
            content: "";
            position: absolute;
            z-index: 0;
            right: -15px;
            top: -45px;
            width: 520px;
            height: 260px;
            background-image:
                linear-gradient(90deg, rgba(241, 248, 243, 1) 0%, rgba(241, 248, 243, 0.55) 28%, rgba(241, 248, 243, 0) 70%),
                url("{{ url_for('static', filename='images/footer_bg.jpg') }}");
            background-size: cover;
            background-position: center;
            opacity: 0.35;
            pointer-events: none;
        }
        .footer-content { position: relative; z-index: 2; padding: 30px 35px 20px; }
        .footer-main { display: flex; align-items: center; justify-content: space-between; gap: 30px; flex-wrap: wrap; }
        .footer-project { max-width: 520px; }
        .footer-project-title { margin-bottom: 6px; color: var(--navy-green); font-size: 1.15rem; font-weight: 800; }
        .footer-project-title span { color: var(--green-dark); }
        .footer-description { margin: 0; color: var(--text-light); font-size: 0.78rem; line-height: 1.6; }
        .footer-technologies { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 13px; }
        .technology-pill {
            padding: 5px 10px;
            border: 1px solid rgba(35, 122, 69, 0.2);
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.7);
            color: var(--green-dark);
            font-size: 0.65rem;
            font-weight: 600;
        }
        .footer-partners { text-align: right; }
        .partners-title { margin-bottom: 10px; color: var(--text-light); font-size: 0.65rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; }
        .footer-logos { display: flex; align-items: center; justify-content: flex-end; gap: 15px; flex-wrap: wrap; }
        .footer-logo-item img { display: block; max-width: 120px; max-height: 40px; width: auto; height: auto; object-fit: contain; }
        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 25px;
            padding-top: 14px;
            border-top: 1px solid rgba(35, 122, 69, 0.15);
            color: var(--text-light);
            font-size: 0.67rem;
        }
        @media (max-width: 991px) {
            .footer-main { align-items: flex-start; flex-direction: column; }
            .footer-partners { width: 100%; text-align: left; }
            .footer-logos { justify-content: flex-start; }
        }


        /* =========================================================
           BALANCED ONE-SCREEN LAYOUT
           All existing content and functionality preserved
        ========================================================= */

